# --- Midscene vision model config ---
# Choose ONE provider below and fill in real values. Do not commit real keys.

# Option A:
# MIDSCENE_MODEL_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# MIDSCENE_MODEL_API_KEY="your-gemini-api-key"
# MIDSCENE_MODEL_NAME="gemini-3.5-flash"
# MIDSCENE_MODEL_FAMILY="gemini"

# Option B:
# MIDSCENE_MODEL_BASE_URL="https://api.openai.com/v1"
# MIDSCENE_MODEL_API_KEY="sk-your-openai-api-key"
# MIDSCENE_MODEL_NAME="gpt-5.5"
# MIDSCENE_MODEL_FAMILY="gpt-5"


# Concurrent execution (optional): set an account pool size N and provide N
# accounts, suffixed _1.._N. Worker count automatically equals N, and each
# worker is pinned to one account slot for its whole run (see e2e/fixture.ts),
# so concurrent workers never share a login/classroom session. Leave unset for
# the default single-account/serial behavior.
# MIABI_TEST_ACCOUNT_POOL_SIZE=3
# MIABI_TEST_PHONE_1=
# MIABI_TEST_PASSWORD_1=
# MIABI_TEST_PHONE_2=
# MIABI_TEST_PASSWORD_2=
# MIABI_TEST_PHONE_3=
# MIABI_TEST_PASSWORD_3=

# --- Environment overrides (optional) ---
# Defaults live in e2e/testdata/environments.ts. Only set these to point the
# suite at a different environment.
# MIABI_APP_BASE_URL=https://aixmy.miaobi.cn
# MIABI_CLASSROOM_API_BASE_URL=https://maliang.miaobi.cn

