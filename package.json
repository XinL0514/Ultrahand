{
  "name": "ultrahand",
  "version": "0.1.0",
  "private": true,
  "description": "AI-driven Web UI automation testing framework built on Midscene + Playwright",
  "type": "module",
  "scripts": {
    "install:browsers": "playwright install chromium",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@midscene/web": "^1.0.0",
    "@playwright/test": "^1.48.0",
    "dotenv": "^16.4.5",
    "playwright": "^1.48.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
